---
import AnimatedText from '../AnimatedText.astro';
import SlamClubs from '../SlamClubs.astro';
import HungaryMap from '../HungaryMap.astro';
import SlamClubForm from '../SlamClubForm.astro';
import { t } from '../../i18n/ui';
import type { Lang } from '../../i18n';
import type { SlamClub } from '../../sanity/lib/api';

interface Props { clubs: SlamClub[]; lang: Lang }
const { clubs, lang } = Astro.props;
---
<!-- Kétfázisú „robbanó" hero: alapállapot Magyarország pink körvonala pinekkel; hoverre
     (érintőn koppintásra) szétrobban, kiugranak a városobjektumok (Országház, szegedi dóm).
     Téma-érzékeny: SÖTÉT módban neon (fekete háttér + screen-blend), VILÁGOS módban magenta
     vonalrajz (fehér háttér + multiply-blend). Csak md+ jelenik meg. -->
<section class="clubs-hero group/obj surface-dark relative overflow-hidden">
  <div class="pointer-events-none absolute -right-10 top-0 h-full w-[60%] max-w-none opacity-0 md:opacity-100">
    <!-- ALAP fázis -->
    <img src="/clubs-map-base.webp" alt="" aria-hidden="true"
      class="clubs-base hero-only-dark absolute inset-0 h-full w-full object-contain object-right opacity-90 mix-blend-screen transition-[opacity,transform] duration-700 ease-out group-hover/obj:scale-110 group-hover/obj:opacity-0" />
    <img src="/clubs-map-base-light.webp" alt="" aria-hidden="true"
      class="clubs-base hero-only-light absolute inset-0 h-full w-full object-contain object-right opacity-90 mix-blend-multiply transition-[opacity,transform] duration-700 ease-out group-hover/obj:scale-110 group-hover/obj:opacity-0" />
    <!-- ROBBANÁS fázis -->
    <img src="/clubs-map-explode.webp" alt="" aria-hidden="true"
      class="clubs-explode hero-only-dark absolute inset-0 h-full w-full scale-95 object-contain object-right opacity-0 mix-blend-screen transition-[opacity,transform] duration-700 ease-out group-hover/obj:scale-110 group-hover/obj:opacity-100" />
    <img src="/clubs-map-explode-light.webp" alt="" aria-hidden="true"
      class="clubs-explode hero-only-light absolute inset-0 h-full w-full scale-95 object-contain object-right opacity-0 mix-blend-multiply transition-[opacity,transform] duration-700 ease-out group-hover/obj:scale-110 group-hover/obj:opacity-100" />
  </div>
  <div class="relative z-10 mx-auto max-w-6xl px-4 py-20 md:py-28 md:pr-[42%]">
    <p class="mb-3 inline-flex items-center gap-2 pt-1 text-xs uppercase leading-[1.6] tracking-[0.2em] text-accent">
      <span class="h-px w-8 bg-accent"></span><span class="inline-block">{t(lang, 'slammers.clubsEyebrow')}</span>
    </p>
    <h1 class="font-display text-5xl leading-[0.9] md:text-8xl"><AnimatedText text={t(lang, 'slammers.clubsTitle')} /></h1>
    <p class="mt-5 max-w-xl text-lg text-surface/75">{t(lang, 'slammers.clubsLead')}</p>
  </div>
</section>

<script>
  // Érintőn nincs hover: koppintásra kapcsoljuk a robbanást (ugyanazt adja, mint a group-hover).
  const hero = document.querySelector('.clubs-hero');
  if (hero && window.matchMedia('(hover: none)').matches) {
    hero.addEventListener('click', () => hero.classList.toggle('obj-on'));
  }
</script>

<style>
  /* Érintős koppintás-állapot: ugyanaz, mint a hover (téma-független, osztály-alapú). */
  .clubs-hero.obj-on :global(.clubs-base) { opacity: 0; transform: scale(1.1); }
  .clubs-hero.obj-on :global(.clubs-explode) { opacity: 1; transform: scale(1.1); }
</style>

<section class="surface-dark relative overflow-hidden bg-ink text-surface">
  <div class="pointer-events-none absolute -left-24 top-0 h-72 w-72 rounded-full bg-accent/15 blur-[120px]"></div>
  <div class="relative z-10 mx-auto max-w-6xl px-4 py-14 md:py-16">
    <SlamClubs clubs={clubs} />

    <!-- Valódi kattintható Magyarország-térkép -->
    <div class="mt-12">
      <p class="mb-4 text-center text-xs uppercase tracking-[0.2em] text-surface/50">{t(lang, 'slammers.mapHint')}</p>
      <HungaryMap clubs={clubs} />
    </div>

    <div id="club-form" class="mt-12 max-w-2xl scroll-mt-24">
      <SlamClubForm />
    </div>
  </div>
</section>
