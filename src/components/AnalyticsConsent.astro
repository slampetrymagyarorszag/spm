---
import type { Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = lang === 'en'
  ? {
    settings: 'Analytics cookie settings',
    title: 'Analytics cookies',
    description: 'If you say yes, we’ll use Google Analytics cookies to see which pages people visit, which ticket links they click and how many registrations go through. That helps us improve the site.',
    choice: 'You can use the whole site either way and change your choice in the footer at any time.',
    accept: 'Allow analytics cookies',
    decline: 'Continue without analytics',
    privacy: 'How Google uses this data',
  }
  : {
    settings: 'Statisztikai sütik beállításai',
    title: 'Statisztikai sütik',
    description: 'Ha engedélyezed, a Google Analytics sütijeivel megnézzük, mely oldalakat látogatjátok, mely jegylinkekre kattintotok, és hány jelentkezés érkezik. Így látjuk, min érdemes javítani az oldalon.',
    choice: 'Az oldalt mindkét esetben használhatod. A választásodat bármikor módosíthatod a láblécben.',
    accept: 'Statisztikai sütik engedélyezése',
    decline: 'Tovább mérés nélkül',
    privacy: 'Így használja a Google az adatokat',
  };
---
<div class="bg-ink py-3 text-center text-sm text-surface">
  <button id="analytics-preferences" type="button" class="underline underline-offset-4" aria-controls="analytics-consent" aria-expanded="false">
    {copy.settings}
  </button>
</div>
<section hidden id="analytics-consent" class="fixed bottom-4 left-4 right-4 z-[70] max-h-[calc(100dvh-2rem)] max-w-md overflow-auto rounded-xl border border-ink/20 bg-surface p-5 text-ink shadow-xl sm:right-auto" aria-labelledby="analytics-consent-title">
  <h2 id="analytics-consent-title" tabindex="-1" class="font-display text-xl">{copy.title}</h2>
  <p class="mt-2 text-sm">{copy.description}</p>
  <p class="mt-2 text-sm">{copy.choice}</p>
  <a href="https://policies.google.com/technologies/partner-sites" class="mt-2 inline-block text-sm underline">{copy.privacy}</a>
  <div class="mt-4 grid gap-2 sm:grid-cols-2">
    <button type="button" data-analytics-choice="declined" class="min-h-11 rounded-md border border-ink/30 px-3 py-2 text-sm font-semibold hover:bg-ink/5 focus-visible:outline-2 focus-visible:outline-offset-2">{copy.decline}</button>
    <button type="button" data-analytics-choice="accepted" class="min-h-11 rounded-md border border-ink/30 px-3 py-2 text-sm font-semibold hover:bg-ink/5 focus-visible:outline-2 focus-visible:outline-offset-2">{copy.accept}</button>
  </div>
</section>

<script>
  import { getAnalyticsPreference, setAnalyticsPreference, startAnalytics, trackTicketClick } from '../lib/analytics';

  const panel = document.querySelector<HTMLElement>('#analytics-consent');
  const settings = document.querySelector<HTMLButtonElement>('#analytics-preferences');

  if (panel && settings) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      settings.setAttribute('aria-expanded', String(open));
    };
    const preference = getAnalyticsPreference();
    if (preference === 'accepted') startAnalytics();
    if (preference === null) setOpen(true);

    settings.addEventListener('click', () => {
      setOpen(panel.hidden);
      if (!panel.hidden) panel.querySelector('h2')?.focus();
    });
    panel.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      setOpen(false);
      settings.focus();
    });
    panel.querySelectorAll<HTMLButtonElement>('[data-analytics-choice]').forEach((button) => {
      button.addEventListener('click', () => {
        setAnalyticsPreference(button.dataset.analyticsChoice === 'accepted' ? 'accepted' : 'declined');
        setOpen(false);
        settings.focus({ preventScroll: true });
      });
    });
  }

  const trackTicket = (event: MouseEvent) => {
    if (event.type === 'auxclick' && event.button !== 1) return;
    const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[data-ticket-event]') : null;
    const slug = link?.dataset.ticketEvent;
    if (slug) trackTicketClick(slug);
  };
  document.addEventListener('click', trackTicket);
  document.addEventListener('auxclick', trackTicket);
</script>
