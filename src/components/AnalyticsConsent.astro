---
import type { Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = lang === 'en'
  ? {
    settings: 'Analytics cookie settings',
    title: 'Analytics cookies',
    description: 'If you agree, we’ll use Google Analytics cookies to count visits, ticket clicks and completed registrations and use those stats to improve the site.',
    choice: 'You can change your choice anytime in the footer.',
    accept: 'Allow analytics',
    decline: 'Continue without analytics',
    privacy: 'How Google uses this data',
  }
  : {
    settings: 'Statisztikai sütik beállításai',
    title: 'Statisztikai sütik',
    description: 'Ha engedélyezed, a Google Analytics sütijeivel mérjük a látogatásokat, a jegylinkekre kattintásokat és a sikeres jelentkezéseket. Ez segít javítani az oldalon.',
    choice: 'A választásodat bármikor módosíthatod a láblécben.',
    accept: 'Engedélyezem a mérést',
    decline: 'Tovább mérés nélkül',
    privacy: 'Így használja a Google az adatokat',
  };
---
<div class="bg-ink py-3 text-center text-sm text-surface">
  <button id="analytics-preferences" type="button" class="underline underline-offset-4" aria-controls="analytics-consent" aria-expanded="false">
    {copy.settings}
  </button>
</div>
<section hidden id="analytics-consent" class="fixed inset-x-0 bottom-0 z-[70] max-h-[min(60dvh,28rem)] overflow-auto border-t border-ink/20 bg-surface text-ink shadow-[0_-6px_24px_-12px_rgba(0,0,0,0.4)]" aria-labelledby="analytics-consent-title" data-nosnippet>
  <div class="mx-auto grid max-w-6xl gap-3 px-4 pt-4 pb-[max(1rem,env(safe-area-inset-bottom))] sm:px-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-8">
    <div class="text-sm">
      <h2 id="analytics-consent-title" tabindex="-1" class="font-display text-xl">{copy.title}</h2>
      <p class="mt-1">{copy.description}</p>
      <p class="mt-1">{copy.choice} <a href="https://policies.google.com/technologies/partner-sites" class="underline underline-offset-2">{copy.privacy}</a></p>
    </div>
    <div class="grid grid-cols-2 gap-2 lg:max-w-[25rem]">
      <button type="button" data-analytics-choice="declined" class="min-h-11 rounded-md border border-ink/30 bg-ink/5 px-3 py-2 text-sm font-semibold hover:bg-ink/10 focus-visible:outline-2 focus-visible:outline-offset-2">{copy.decline}</button>
      <button type="button" data-analytics-choice="accepted" class="min-h-11 rounded-md border border-ink/30 bg-accent/20 px-3 py-2 text-sm font-semibold hover:bg-accent/30 focus-visible:outline-2 focus-visible:outline-offset-2">{copy.accept}</button>
    </div>
  </div>
</section>

<script>
  import { getAnalyticsPreference, setAnalyticsPreference, startAnalytics, trackTicketClick } from '../lib/analytics';

  const panel = document.querySelector<HTMLElement>('#analytics-consent');
  const settings = document.querySelector<HTMLButtonElement>('#analytics-preferences');

  if (panel && settings) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      settings.setAttribute('aria-expanded', String(open));
    };
    const preference = getAnalyticsPreference();
    if (preference === 'accepted') startAnalytics();
    if (preference === null) setOpen(true);

    settings.addEventListener('click', () => {
      setOpen(panel.hidden);
      if (!panel.hidden) panel.querySelector('h2')?.focus();
    });
    panel.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      setOpen(false);
      settings.focus();
    });
    panel.querySelectorAll<HTMLButtonElement>('[data-analytics-choice]').forEach((button) => {
      button.addEventListener('click', () => {
        setAnalyticsPreference(button.dataset.analyticsChoice === 'accepted' ? 'accepted' : 'declined');
        setOpen(false);
        settings.focus({ preventScroll: true });
      });
    });
  }

  const trackTicket = (event: MouseEvent) => {
    if (event.type === 'auxclick' && event.button !== 1) return;
    const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[data-ticket-event]') : null;
    const slug = link?.dataset.ticketEvent;
    if (slug) trackTicketClick(slug);
  };
  document.addEventListener('click', trackTicket);
  document.addEventListener('auxclick', trackTicket);
</script>
