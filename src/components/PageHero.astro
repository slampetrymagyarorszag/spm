---
import ScrollMic from './ScrollMic.astro';
import AnimatedText from './AnimatedText.astro';
interface Props { label?: string; title: string; lead?: string; mic?: boolean; object?: string; objectHover?: string; objectAlt?: string }
const { label, title, lead, mic = false, object, objectHover, objectAlt = '' } = Astro.props;
// Világos módban átlátszó (luminancia-alfa) változatot töltünk, hogy a kép a világos
// panelen is jól nézzen ki (a sötét-only mix-blend-screen helyett normál keverés).
const lightVariant = (src?: string) => (src && src.endsWith('.webp') ? src.replace(/\.webp$/, '-light.webp') : src);
const objectLight = lightVariant(object);
const objectHoverLight = lightVariant(objectHover);

// A változatokat CSS-változóként adjuk át, és háttérképként rajzoljuk ki (a szabályok a
// global.css-ben, `.hero-obj`). Ez azért kell, mert a böngésző CSAK azt a képet tölti le,
// amelyik egy ténylegesen érvényes szabályban szerepel — az <img>-et viszont a
// `display:none` sem állítja meg, így korábban mind a négy változat lejött minden
// oldalletöltésnél, pedig hármat sosem látott a látogató.
const objStyle = object
  ? [
      `--hero-dark:url('${object}')`,
      objectLight && `--hero-light:url('${objectLight}')`,
      objectHover && `--hero-dark-break:url('${objectHover}')`,
      objectHoverLight && `--hero-light-break:url('${objectHoverLight}')`,
    ].filter(Boolean).join(';')
  : undefined;
---
<section class="hero-group surface-dark relative overflow-hidden bg-ink text-surface">
  {mic && <ScrollMic />}
  {object && (
    <div
      class="hero-obj hero-fade absolute bottom-0 left-0 hidden md:block"
      style={objStyle}
      role={objectAlt ? 'img' : undefined}
      aria-label={objectAlt || undefined}
      aria-hidden={objectAlt ? undefined : 'true'}
    >
      <span class="hero-obj-layer hero-obj-base"></span>
      {objectHover && <span class="hero-obj-layer hero-obj-hover"></span>}
    </div>
  )}
  <div class={`relative z-10 mx-auto max-w-6xl px-4 py-20 md:py-28 ${object ? 'md:pl-[34%]' : ''}`}>
    {label && (
      <p class="mb-3 inline-flex items-center gap-2 pt-1 text-xs uppercase leading-[1.6] tracking-[0.2em] text-accent">
        <span class="h-px w-8 bg-accent"></span><span class="inline-block">{label}</span>
      </p>
    )}
    <h1 class="font-display text-5xl md:text-8xl leading-[0.9] max-w-3xl"><AnimatedText text={title} /></h1>
    {lead && <p class="mt-5 max-w-xl text-lg text-surface/75">{lead}</p>}
  </div>
</section>
