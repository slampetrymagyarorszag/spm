---
import NotFound from '../../404.astro';
import EventDetail from '../../../components/pages/EventDetail.astro';
import { getEventBySlug } from '../../../sanity/lib/api';
import { sanityClient } from 'sanity:client';
export const prerender = false;
const { slug } = Astro.params;
const ev = await getEventBySlug(sanityClient, slug!);
if (!ev) Astro.response.status = 404;
---
{ev ? <EventDetail event={ev} lang="en" /> : <NotFound />}
