---
import NotFound from '../../404.astro';
import NewsPost from '../../../components/pages/NewsPost.astro';
import { getPostBySlug } from '../../../sanity/lib/api';
import { sanityClient } from 'sanity:client';
export const prerender = false;
const { slug } = Astro.params;
const post = await getPostBySlug(sanityClient, slug!);
if (!post) Astro.response.status = 404;
---
{post ? <NewsPost post={post} lang="en" /> : <NotFound />}
