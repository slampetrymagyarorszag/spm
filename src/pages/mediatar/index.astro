---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaLibrary from '../../components/pages/MediaLibrary.astro';
import { getMedia, getMediaConfig } from '../../sanity/lib/api';
import { fetchChannelUploads, fetchPlaylistItems, parsePlaylistId, fetchChannelPlaylists, mergePlaylistDefinitions } from '../../lib/youtube';
import { sanityClient } from 'sanity:client';

export const prerender = false;
// Friss tartalom új build nélkül, korlátozott YouTube API-terheléssel.
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=900, stale-while-revalidate=300');


const apiKey = process.env.YOUTUBE_API_KEY ?? import.meta.env.YOUTUBE_API_KEY;

const [media, config, videos] = await Promise.all([
  getMedia(sanityClient),
  getMediaConfig(sanityClient),
  fetchChannelUploads({
    apiKey,
    channelId: process.env.YOUTUBE_CHANNEL_ID ?? import.meta.env.YOUTUBE_CHANNEL_ID,
    handle: process.env.YOUTUBE_CHANNEL_HANDLE ?? import.meta.env.YOUTUBE_CHANNEL_HANDLE,
    max: 9,
  }),
]);

// Lejátszási listák két forrásból: (1) a médiatár „lejátszási lista" elemei, és
// (2) a beállításokban megadott listák. Mindkettő elfogad teljes URL-t vagy nyers ID-t.
const automaticPlaylists = config.youtubeAutoPlaylists === false ? [] : await fetchChannelPlaylists({
  apiKey,
  channelId: process.env.YOUTUBE_CHANNEL_ID ?? import.meta.env.YOUTUBE_CHANNEL_ID,
  handle: process.env.YOUTUBE_CHANNEL_HANDLE ?? import.meta.env.YOUTUBE_CHANNEL_HANDLE,
  max: 12,
});
const playlistDefs = mergePlaylistDefinitions([
  ...media.filter((m) => m.kind === 'playlist').map((m) => ({ title: m.title, id: parsePlaylistId(m.playlistUrl) })),
  ...(config.youtubePlaylists ?? []).map((p) => ({ title: p.title || 'Lejátszási lista', id: parsePlaylistId(p.playlistId) })),
], automaticPlaylists);
const playlists = await Promise.all(
  playlistDefs.map(async (p) => ({
    title: p.title || 'Lejátszási lista',
    url: p.url,
    videoCount: p.videoCount,
    videos: await fetchPlaylistItems(apiKey, p.id!, 6),
  })),
);
// A galéria-rácsban a playlist-elemek ne jelenjenek meg (külön szekcióként jönnek).
const galleryMedia = media.filter((m) => m.kind !== 'playlist');
const downloads = (config.downloads ?? []).filter((d) => d.fileUrl || d.url);
const hasAny = galleryMedia.length > 0 || videos.length > 0 || playlists.length > 0 || downloads.length > 0;
---
<BaseLayout title="Médiatár">
  <MediaLibrary videos={videos} playlists={playlists} galleryMedia={galleryMedia} downloads={downloads} hasAny={hasAny} lang="hu" />
</BaseLayout>
