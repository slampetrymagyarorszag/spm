---
import NewsPost from '../../components/pages/NewsPost.astro';
import { getPostBySlug } from '../../sanity/lib/api';
import { sanityClient } from 'sanity:client';
export const prerender = false;
const { slug } = Astro.params;
const post = await getPostBySlug(sanityClient, slug!);
if (!post) return Astro.redirect('/hirek');
---
<NewsPost post={post} lang="hu" />
