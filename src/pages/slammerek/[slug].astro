---
import NotFound from '../404.astro';
import SlammerProfile from '../../components/pages/SlammerProfile.astro';
import { getSlammerBySlug } from '../../sanity/lib/api';
import { sanityClient } from 'sanity:client';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=300, stale-while-revalidate=300');
const { slug } = Astro.params;
const slammer = await getSlammerBySlug(sanityClient, slug!);
if (!slammer) Astro.response.status = 404;
---
{slammer ? <SlammerProfile slammer={slammer} lang="hu" /> : <NotFound />}
