PUBLIC_SANITY_PROJECT_ID=your_project_id
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_VISUAL_EDITING_ENABLED=false
RESEND_API_KEY=your_resend_api_key
MAIL_FROM=Slam Poetry <no-reply@slampoetry.hu>
CONTACT_EMAIL=contest@slampoetry.hu
# A látogatói beküldésekről (slammer-jelentkezés, esemény-tipp, klub, adatmódosítás) MINDIG
# ide is megy értesítő — akkor is, ha a Studióban nincs bekapcsolva az értesítés. Üresen a
# media@slampoetry.hu az alapértelmezés.
NOTIFY_FALLBACK_EMAIL=media@slampoetry.hu
YOUTUBE_API_KEY=your_youtube_data_api_key
YOUTUBE_CHANNEL_ID=
YOUTUBE_CHANNEL_HANDLE=@slampoetry
SANITY_WRITE_TOKEN=
SANITY_FORM_TOKEN=
# Facebook hír-import (Studio → „Facebook hír import”). Page access token + az oldal ID-ja.
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=

# --- Sajtóközlemény-kiküldés ---
# A Studio „Sajtóközlemény küldése” felületén ezt a jelszót kell begépelni. Nélküle a
# végpont semmit nem küld ki (így nem lehet a nevetekben leveleket kiküldeni).
PRESS_SEND_SECRET=
# A leiratkozó linkek aláírásához. Hosszú, véletlen érték legyen, és NE változzon később,
# különben a már kiküldött levelek leiratkozó linkjei érvénytelenné válnak.
PRESS_UNSUB_SECRET=
# A sajtóközlemények feladója és válaszcíme (ne noreply legyen — az újságíró válaszolni akar).
PRESS_FROM=Slam Poetry Magyarország <sajto@slampoetry.hu>
PRESS_REPLY_TO=media@slampoetry.hu
